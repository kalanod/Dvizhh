discovery.docker "application" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT_NAME")]
  }
}

discovery.relabel "application" {
  targets = discovery.docker.application.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "nginx|web-app|backend|auth-api|recommendation-service"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }
}

loki.source.docker "application" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.application.output
  forward_to = [loki.process.application.receiver]
}

loki.process "application" {
  stage.json {
    expressions    = { level = "level" }
    drop_malformed = true
  }

  stage.template {
    source   = "level"
    template = "{{ ToLower .Value }}"
  }

  stage.labels {
    values = { level = "level" }
  }

  stage.match {
    selector = "{service_name=~\".+\",level!~\"debug|info|warning|error|critical\"}"
    action   = "drop"
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.receiver.otlp "proxies" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  output {
    traces = [otelcol.processor.attributes.proxy_traces.input]
  }
}

otelcol.processor.attributes "proxy_traces" {
  action {
    key    = "http.target"
    action = "delete"
  }
  action {
    key    = "http.user_agent"
    action = "delete"
  }
  action {
    key    = "net.sock.peer.addr"
    action = "delete"
  }

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
