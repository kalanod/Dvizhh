POSTGRES_DB=dvizh_data
POSTGRES_USER=dvizh_app
POSTGRES_PASSWORD=change-me
RECSYS_READER_PASSWORD=change-me

VECTOR_DB=dvizh_vectors
VECTOR_USER=dvizh
VECTOR_PASSWORD=change-me

DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_TIMEOUT_SECONDS=5

REDIS_URL=redis://redis:6379/0
REDIS_TIMEOUT_SECONDS=5
RECOMMENDATION_TIMEOUT_SECONDS=5
RECOMMENDATION_GRPC_ADDRESS=recommendation-service:8001
RECOMMENDATION_GRPC_TIMEOUT_SECONDS=2
RANKER_MODEL_URI=
PREVIOUS_RANKER_MODEL_URI=
VECTOR_MODEL_ID=
VECTOR_INDEX_REVISION=
PREVIOUS_VECTOR_MODEL_ID=
PREVIOUS_VECTOR_INDEX_REVISION=

MINIO_ROOT_USER=dvizh
MINIO_ROOT_PASSWORD=change-me-please
MINIO_BUCKET=media
MINIO_CONSOLE_PORT=9873

MINIO_SECURE=false
MINIO_TIMEOUT_SECONDS=10
MEDIA_MAX_MIB=10
MEDIA_MAX_PIXELS=25000000

# Внешние порты сайта: HTTP и HTTPS
NGINX_PORT=8080
NGINX_HTTPS_PORT=8021

# Stable signing key for auth cookies (at least 32 random characters).
# Empty: random process key; signing in again is required after auth restarts.
AUTH_JWT_SECRET=

# Яндекс Карты: JavaScript API, Геосаджест и HTTP Геокодер.
# Для JS API добавьте localhost и домен сайта в ограничения HTTP Referer.
YANDEX_MAPS_API_KEY=
# Отдельный стабильный секрет от 32 символов; одинаковый для всех backend-реплик.
# Пустое значение: временный ключ процесса, старые токены карты сбросятся при рестарте.
DISCOVERY_TOKEN_SECRET=
YANDEX_SUGGEST_API_KEY=
# Можно оставить пустым, если Геокодер подключён к YANDEX_MAPS_API_KEY.
YANDEX_GEOCODER_API_KEY=
# Необязателен, если Поиск по организациям подключён к ключу Геокодера или карты.
YANDEX_SEARCH_API_KEY=

# MLflow: docker compose -p dvizh-mlflow -f compose.mlflow.yaml up -d --build
DVIZH_APP_NETWORK=dvizh_default
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MLFLOW_HTTP_PORT=80
MLFLOW_HTTPS_PORT=443
MLFLOW_DATABASE_PASSWORD=change-me
MLFLOW_STORAGE_SECRET_KEY=change-me-mlflow
