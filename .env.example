POSTGRES_DB=dvizh_data
POSTGRES_USER=dvizh_app
POSTGRES_PASSWORD=change-me
RECSYS_READER_PASSWORD=change-me

VECTOR_DB=dvizh_vectors
VECTOR_USER=dvizh
VECTOR_PASSWORD=change-me

MINIO_ROOT_USER=dvizh
MINIO_ROOT_PASSWORD=change-me-please
MINIO_BUCKET=media

MINIO_SECURE=false
MINIO_TIMEOUT_SECONDS=10
MEDIA_MAX_MIB=10
MEDIA_MAX_PIXELS=25000000

# Порт сайта на хосте (если 8080 занят другой программой)
NGINX_PORT=8080

# Яндекс Карты: JavaScript API, Геосаджест и HTTP Геокодер.
# Для JS API добавьте localhost и домен сайта в ограничения HTTP Referer.
YANDEX_MAPS_API_KEY=
YANDEX_SUGGEST_API_KEY=
# Можно оставить пустым, если Геокодер подключён к YANDEX_MAPS_API_KEY.
YANDEX_GEOCODER_API_KEY=
# Необязателен, если Поиск по организациям подключён к ключу Геокодера или карты.
YANDEX_SEARCH_API_KEY=

# MLflow: docker compose --profile ml up -d --build mlflow
MLFLOW_PORT=5000
MLFLOW_DATABASE_PASSWORD=change-me
MLFLOW_STORAGE_SECRET_KEY=change-me-mlflow
